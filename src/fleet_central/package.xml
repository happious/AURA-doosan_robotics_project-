<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_central</name>
  <version>0.1.0</version>
  <description>AURA 중앙 계층: 미션 배차(dispatcher), SQLite 기록(db_manager), 혼잡구역 keepout 코스트맵 마스크(crowd_keepout).</description>
  <maintainer email="team@example.com">robot_control_team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>fleet_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
