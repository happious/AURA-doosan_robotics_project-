<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot1_control</name>
  <version>0.1.0</version>
  <description>robot1(응급/AED 대응 로봇) 미션 FSM. 중앙과 ExecuteMission 액션 + EmergencyStop 서비스로 완전 연결.</description>
  <maintainer email="team@example.com">robot_control_team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>fleet_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>irobot_create_msgs</depend>
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
