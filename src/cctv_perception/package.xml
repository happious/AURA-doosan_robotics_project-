  <version>0.1.0</version>
  <description>고정 CCTV 인지 노드: YOLO11-pose 기반 쓰러짐 감지, 인원수 카운트, 혼잡구역(hot_place) 감지.</description>
  <maintainer email="team@example.com">robot_control_team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
